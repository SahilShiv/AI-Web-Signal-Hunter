# AI Web Signal Hunter - Environment Configuration
# Copy this file to .env and insert your API keys

# AI Provider Credentials
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Default AI Provider ("Groq" or "Gemini")
DEFAULT_AI_PROVIDER=Groq

# Model Selection
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# Crawler Politeness & Performance
DEFAULT_CRAWL_LIMIT=25
REQUEST_TIMEOUT=12
REQUEST_DELAY=0.8
MIN_RELEVANCE_THRESHOLD=60
ANALYSIS_BATCH_SIZE=5

# User Agent
CRAWLER_USER_AGENT=AI-Web-Signal-Hunter/1.0 (+https://github.com/internship/ai-web-signal-hunter; polite bot)

